---
import Rating from '../../components/rating.mnx';
import Card from '../../components/card.mnx';
import Inbox from '../../components/inbox.mnx';
import Counter from '../../components/counter.mnx.tsx';
---
<html>
  <head><meta charset="utf-8"><title>Astro</title></head>
  <body>
    <Rating id="r" class="big" value={1} client:load />
    <Card heading="Astro" data-kind="static">
      <h2 slot="title">Custom {'{braces}'}</h2>
      <p>Body</p>
    </Card>
    <Inbox />
    <Counter id="counter" count={4} client:load />
    <script>
      await customElements.whenDefined('mnx-rating');
      await customElements.whenDefined('mnx-counter');
      window.ready = true;
    </script>
  </body>
</html>
