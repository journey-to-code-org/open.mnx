{
  "name": "@mnx/unplugin",
  "version": "1.6.0",
  "description": "Compile .mnx components in Vite, Rollup, webpack, esbuild and Rspack, with React and Vue wrappers picked automatically",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/journey-to-code-org/open.mnx.git",
    "directory": "plugin"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./vite": "./src/vite.js",
    "./rollup": "./src/rollup.js",
    "./webpack": "./src/webpack.js",
    "./esbuild": "./src/esbuild.js",
    "./rspack": "./src/rspack.js",
    "./astro": "./src/astro.js",
    "./astro/server": "./src/astro-server.js",
    "./astro/client": "./src/astro-client.js",
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "unplugin": "3.7.0"
  },
  "peerDependencies": {
    "@mnx/compiler": "^1.3.0",
    "@mnx/runtime": "^1.0.0"
  },
  "devDependencies": {
    "@mnx/compiler": "file:../compiler",
    "@mnx/runtime": "file:../runtime",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-vue": "6.0.10",
    "astro": "7.4.7",
    "esbuild": "0.28.2",
    "lit": "3.3.3",
    "playwright": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup": "4.68.0",
    "sass": "1.108.1",
    "solid-js": "1.9.18",
    "svelte": "5.57.3",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-solid": "2.11.15",
    "vue": "3.5.45",
    "webpack": "5.112.2"
  },
  "files": [
    "src",
    "client.d.ts"
  ],
  "peerDependenciesMeta": {
    "@mnx/compiler": {
      "optional": true
    }
  }
}
