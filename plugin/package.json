{
  "name": "@zubra/unplugin",
  "version": "5.9.2",
  "description": "Compile .zb components in Vite, Rollup, webpack, esbuild and Rspack, with React and Vue wrappers picked automatically",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/journey-to-code-org/zubra.git",
    "directory": "plugin"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./rollup": {
      "types": "./src/rollup.d.ts",
      "default": "./src/rollup.js"
    },
    "./webpack": {
      "types": "./src/webpack.d.ts",
      "default": "./src/webpack.js"
    },
    "./esbuild": {
      "types": "./src/esbuild.d.ts",
      "default": "./src/esbuild.js"
    },
    "./loader": "./src/loader.cjs",
    "./rspack": {
      "types": "./src/rspack.d.ts",
      "default": "./src/rspack.js"
    },
    "./astro": {
      "types": "./src/astro.d.ts",
      "default": "./src/astro.js"
    },
    "./astro/server": "./src/astro-server.js",
    "./astro/client": "./src/astro-client.js",
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "unplugin": "3.7.0"
  },
  "peerDependencies": {
    "@zubra/compiler": "^5.9.0",
    "@zubra/runtime": "^5.9.0"
  },
  "devDependencies": {
    "@zubra/compiler": "file:../compiler",
    "@zubra/runtime": "file:../runtime",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-vue": "6.0.10",
    "astro": "7.4.7",
    "esbuild": "0.28.2",
    "lit": "3.3.3",
    "playwright": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup": "4.68.0",
    "sass": "1.108.1",
    "solid-js": "1.9.18",
    "svelte": "5.57.3",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-solid": "2.11.15",
    "vue": "3.5.45",
    "webpack": "5.112.2"
  },
  "files": [
    "src",
    "client.d.ts"
  ],
  "peerDependenciesMeta": {
    "@zubra/compiler": {
      "optional": true
    }
  }
}
