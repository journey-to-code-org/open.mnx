{
  "name": "zubra",
  "displayName": "Zubra",
  "description": "Language support for Zubra Web Components: syntax highlighting, diagnostics, completion, hover and go to definition",
  "version": "4.3.0",
  "publisher": "journey-to-code",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/journey-to-code-org/zubra.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "zubra",
        "aliases": [
          "zubra"
        ],
        "extensions": [
          ".zb"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zubra",
        "scopeName": "text.html.zb",
        "path": "./syntaxes/zubra.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.css": "css",
          "source.css.scss": "scss",
          "meta.embedded.expression.zb": "javascript"
        }
      }
    ],
    "configuration": {
      "title": "zubra",
      "properties": {
        "zubra.compiler": {
          "type": "string",
          "default": "",
          "description": "Path to the Zubra CLI. Empty: use @zubra/compiler (WebAssembly) if installed in the workspace, else `zubra` on PATH."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@zubra/language-server": "file:../language-server",
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
