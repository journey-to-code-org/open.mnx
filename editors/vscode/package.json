{
  "name": "zubra",
  "displayName": "Zubra",
  "description": "Language support for Zubra Web Components: syntax highlighting, diagnostics, completion, hover, go to definition and formatting",
  "version": "5.5.0",
  "publisher": "JourneytoCode",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/journey-to-code-org/zubra.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "zubra",
        "aliases": [
          "zubra"
        ],
        "extensions": [
          ".zb"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/zb-light.svg",
          "dark": "./icons/zb-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "zubra",
        "scopeName": "text.html.zb",
        "path": "./syntaxes/zubra.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.css": "css",
          "source.css.scss": "scss",
          "meta.embedded.expression.zb": "javascript"
        }
      }
    ],
    "configuration": {
      "title": "zubra",
      "properties": {
        "zubra.compiler": {
          "type": "string",
          "default": "",
          "description": "Path to the Zubra CLI. Empty: use @zubra/compiler (WebAssembly) if installed in the workspace, else `zubra` on PATH."
        },
        "zubra.format.printWidth": {
          "type": "number",
          "default": 100,
          "minimum": 20,
          "description": "Formatting: the line width a tag that starts its line is fitted into before its attributes go one per line. Indentation follows the editor's own settings. Takes effect after reloading the window."
        }
      }
    },
    "configurationDefaults": {
      "[zubra]": {
        "editor.defaultFormatter": "JourneytoCode.zubra"
      }
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@zubra/language-server": "file:../language-server",
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "overrides": {
    "minimatch": "11.0.5"
  },
  "icon": "icon.png",
  "keywords": [
    "zubra",
    "web components",
    "custom elements",
    "zb",
    "language server"
  ],
  "galleryBanner": {
    "color": "#14161F",
    "theme": "dark"
  },
  "homepage": "https://journey-to-code-org.github.io/zubra/",
  "bugs": {
    "url": "https://github.com/journey-to-code-org/zubra/issues"
  }
}
