{
  "name": "@zubra/language-server",
  "version": "5.5.0",
  "description": "Language server for .zb components: diagnostics, completion, hover and go to definition",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/journey-to-code-org/zubra.git",
    "directory": "editors/language-server"
  },
  "type": "module",
  "bin": {
    "zubra-language-server": "server.js"
  },
  "exports": {
    ".": "./server.js",
    "./analysis": "./analysis.js"
  },
  "files": [
    "server.js",
    "analysis.js",
    "backend.js"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "vscode-languageserver": "11.0.0",
    "vscode-languageserver-textdocument": "1.0.16"
  }
}
