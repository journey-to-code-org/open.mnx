<script>
  import { provide, state, signal } from '@zubra/runtime'
  import { theme } from './theme.js'

  const current = state('dark')
  provide(theme, signal(current))
  function toggle() {
    current.set(current.get() === 'dark' ? 'light' : 'dark')
  }
</script>
<zb-theme-provider>
  <div><button type="button" onclick={toggle}>toggle</button><zb-slot></zb-slot></div>
</zb-theme-provider>
