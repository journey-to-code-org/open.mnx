<!-- A required amount, like the registry's money input: the anchor is an <input>. -->
<script>
  import { validity } from '@mnx/runtime'
  validity(() => (required && value == null ? "Enter an amount" : ""))
  function input(event) {
    value = event.target.value === "" ? null : Number(event.target.value)
  }
</script>
<mnx-amount form-associated value:model={null} required={false}>
  <div><input inputmode="decimal" aria-label="Amount" oninput={input}></div>
</mnx-amount>
