<script>
  import './badge.zb'
  const people = [{ name: "Ada", unread: 3 }, { name: "Linus", unread: 0 }]
</script>
<zb-inbox items={people} title="Inbox">
  <section>
    <h1>{title}</h1>
    <zb-each items={items} as="item" key={item.name}>
      <zb-badge label={item.name} count={item.unread} info={{ color: item.unread > 0 ? "red" : "gray" }} class="row" data-who={item.name}>
        <em slot="icon">{item.unread > 0 ? "*" : "-"}</em>{item.unread > 0 ? "unread" : "read"}
      </zb-badge>
    </zb-each>
    <x-widget config={{ size: items.length }} mode="plain"></x-widget>
  </section>
</zb-inbox>
