<!--
  @fires send - Sent.
-->
<script>
  import { emit, keys, submit } from '@mnx/runtime'
  import './swatch-pick.mnx'
  let typed = 0
  let color = "#000"
  const helper = keys('mod+k', () => (typed = typed + 100))
  const after = submit(() => (typed = typed + 1000))
</script>
<mnx-reply>
  <form onsubmit.prevent={() => emit('send', color)}>
    <select name="sort" onchange.submit><option>new</option><option>old</option></select>
    <textarea name="body" required onkeydown.mod.enter.prevent.submit={() => (typed = typed + 1)} onkeydown={helper}></textarea>
    <button type="button" class="jsx-style" onclick={after}>JSX style</button>
    <mnx-swatch value:bind={color}></mnx-swatch>
    <output>{typed} {color}</output>
  </form>
</mnx-reply>
