<!-- The js-framework-benchmark table: keyed rows with a label and a selected state. -->
<zb-bench rows={[]}>
  <table>
    <tbody>
      <zb-each items={rows} as="row" key={row.id}>
        <tr class={row.selected ? "danger" : ""}><td class="id">{row.id}</td><td><a class="label">{row.label}</a></td></tr>
      </zb-each>
    </tbody>
  </table>
</zb-bench>
