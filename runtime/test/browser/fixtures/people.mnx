<mnx-people people={[{ name: "Ada", role: "math" }, { name: "Linus", role: "kernels" }]} tags={["x", "y"]}>
  <div>
    <ul>
      <mnx-each items={people} as="person">
        <li><b>{person.name}</b> works on {person.role}</li>
      </mnx-each>
    </ul>
    <p><mnx-each items={tags} as="tag">#{tag} </mnx-each></p>
  </div>
</mnx-people>
