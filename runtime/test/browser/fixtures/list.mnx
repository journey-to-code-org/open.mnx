<mnx-list items={["a", "b"]} show={true} heading="Things">
  <section>
    <h2>{heading}</h2>
    <mnx-if test={show && items.length > 0}>
      <ul>
        <mnx-each items={items} as="item" index="i">
          <li data-i={i}>{item}</li>
        </mnx-each>
      </ul>
      <mnx-else><p>Nothing to show</p></mnx-else>
    </mnx-if>
    <footer>{items.length} items</footer>
  </section>
</mnx-list>
