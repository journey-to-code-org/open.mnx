<!-- Reads a signal that outlives it, through a list, a conditional, a slot and a resource. -->
<script>
  import { resource } from '@mnx/runtime'
  import { shared } from './shared-state.js'
  const data = resource(() => Promise.resolve(shared.get()))
</script>
<mnx-shared items={[1, 2, 3]}>
  <mnx-each items={items} as="item" key={item}><i onclick={() => shared.set(item)}>{item * shared.get()}</i></mnx-each>
  <mnx-if test={shared.get() > 0}><b>{shared.get()}</b></mnx-if>
  <mnx-await value={data}><mnx-then as="v">{v}</mnx-then></mnx-await>
  <mnx-slot></mnx-slot>
</mnx-shared>
