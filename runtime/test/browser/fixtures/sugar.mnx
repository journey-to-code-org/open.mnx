<script>
  let on = false
  let size = 10
  let tone = "red"
  let dialog = null
  let log = []
  let mode = "a"
  const note = (entry) => (log = [...log, entry])
</script>
<style>
  .on { font-weight: 700 }
</style>
<mnx-sugar>
  <mnx-document onkeydown.shift.k={() => note("K")} onkeydown.escape={() => note("esc")}></mnx-document>
  <p class="base" class:on class:big={size > 20} style:font-size={size + "px"} style:--tone={tone}>text</p>
  <form onsubmit.prevent={() => note("submit")}><input onkeydown.enter={() => note("enter")}><button>go</button></form>
  <div class="outer" onclick.self={() => note("self")}><span class="inner">x</span></div>
  <dialog ref={dialog}></dialog>
  <mnx-if test={mode === "a"}>A<mnx-else-if test={mode === "b"}>B</mnx-else-if><mnx-else>C</mnx-else></mnx-if>
  <output>{log.join(",")}</output>
  <button type="button" class="change" onclick={() => ((on = true), (size = 30), (tone = null), (mode = mode === "a" ? "b" : "c"))}>change</button>
</mnx-sugar>
