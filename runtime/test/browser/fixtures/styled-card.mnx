<!-- A card with scoped styles. -->
<style>
  :host { display: block; outline: 1px solid rgb(1, 2, 3) }
  h2 { color: rgb(255, 0, 0) }
  p { color: rgb(0, 128, 0); padding: 1px }
</style>
<mnx-styled-card heading="Card">
  <mnx-slot name="title"><h2>{heading}</h2></mnx-slot>
  <section><mnx-slot><p>Empty</p></mnx-slot></section>
</mnx-styled-card>
