<script>
  import { hydrated } from '@mnx/runtime'
  const live = hydrated()
</script>
<mnx-filters>
  <form>
    <input name="q">
    <mnx-if test={!live}><button class="apply">Apply</button></mnx-if>
    <span class="hint" class:on={live}>{live ? "Filters apply as you type" : "Press Apply"}</span>
  </form>
</mnx-filters>
