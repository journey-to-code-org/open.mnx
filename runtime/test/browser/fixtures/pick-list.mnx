<script>
  const OPTIONS = ["small", "medium", "large"]
  let size = "large"
</script>
<pick-list>
  <select value={size} onchange={(event) => (size = event.target.value)}>
    <mnx-each items={OPTIONS} as="option" key={option}><option value={option}>{option}</option></mnx-each>
  </select>
  <output>{size}</output>
  <button type="button" onclick={() => (size = "medium")}>medium</button>
</pick-list>
