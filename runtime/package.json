{
  "name": "@mnx/runtime",
  "version": "2.0.0",
  "description": "Browser runtime for mnx compiled components, built on the TC39 Signals API",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/journey-to-code-org/open.mnx.git",
    "directory": "runtime"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./signal": {
      "types": "./types/signal.d.ts",
      "default": "./src/signal.js"
    },
    "./effect": {
      "types": "./types/effect.d.ts",
      "default": "./src/effect.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./src/react.js"
    },
    "./vue": {
      "types": "./types/vue.d.ts",
      "default": "./src/vue.js"
    },
    "./angular": {
      "types": "./types/angular.d.ts",
      "default": "./src/angular.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./src/server.js"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:browser": "node --test \"test/browser/*.test.js\"",
    "test:tools": "node --test \"test/tools/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@angular/core": ">=16",
    "@angular/forms": ">=16",
    "react": ">=18",
    "vue": "^3.3"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@babel/core": "8.1.0",
    "@types/react": "19.3.0",
    "ajv": "^8.20.0",
    "custom-elements-manifest": "^2.1.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dom18": "npm:react-dom@18.3.1",
    "react18": "npm:react@18.3.1",
    "rxjs": "7.8.2",
    "signal-polyfill": "0.2.2",
    "typescript": "^7.0.2",
    "vscode-html-languageservice": "5.6.2",
    "vscode-languageserver-textdocument": "1.0.16",
    "vue": "3.5.45"
  },
  "files": [
    "src",
    "types"
  ]
}
