{
  "name": "@zubra/runtime",
  "version": "5.7.0",
  "description": "Browser runtime for Zubra compiled components, built on the TC39 Signals API",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/journey-to-code-org/zubra.git",
    "directory": "runtime"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "production": "./dist/production/index.js",
      "default": "./src/index.js"
    },
    "./signal": {
      "types": "./types/signal.d.ts",
      "production": "./dist/production/signal.js",
      "default": "./src/signal.js"
    },
    "./effect": {
      "types": "./types/effect.d.ts",
      "production": "./dist/production/effect.js",
      "default": "./src/effect.js"
    },
    "./spread": {
      "types": "./types/spread.d.ts",
      "production": "./dist/production/spread.js",
      "default": "./src/spread.js"
    },
    "./zag": {
      "types": "./types/zag.d.ts",
      "production": "./dist/production/zag.js",
      "default": "./src/zag.js"
    },
    "./primitives": {
      "types": "./types/primitives.d.ts",
      "production": "./dist/production/primitives.js",
      "default": "./src/primitives.js"
    },
    "./motion": {
      "types": "./types/motion.d.ts",
      "production": "./dist/production/motion.js",
      "default": "./src/motion.js"
    },
    "./bridge": {
      "types": "./types/bridge.d.ts",
      "production": "./dist/production/bridge.js",
      "default": "./src/bridge.js"
    },
    "./context": {
      "types": "./types/context.d.ts",
      "production": "./dist/production/context.js",
      "default": "./src/context.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "production": "./dist/production/react.js",
      "default": "./src/react.js"
    },
    "./vue": {
      "types": "./types/vue.d.ts",
      "production": "./dist/production/vue.js",
      "default": "./src/vue.js"
    },
    "./angular": {
      "types": "./types/angular.d.ts",
      "default": "./fesm2022/zubra-runtime-angular.mjs"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "production": "./dist/production/server.js",
      "default": "./src/server.js"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:browser": "node --test \"test/browser/*.test.js\"",
    "test:tools": "node --test \"test/tools/*.test.js\"",
    "build:production": "node scripts/build-production.js"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@angular/core": ">=16",
    "@angular/forms": ">=16",
    "@zag-js/vanilla": ">=1.47",
    "react": ">=18",
    "vue": "^3.3"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    },
    "@zag-js/vanilla": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@babel/core": "8.1.0",
    "@types/react": "19.3.0",
    "@zag-js/combobox": "1.47.0",
    "@zag-js/vanilla": "1.47.0",
    "ajv": "^8.20.0",
    "custom-elements-manifest": "^2.1.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dom18": "npm:react-dom@18.3.1",
    "react18": "npm:react@18.3.1",
    "rxjs": "7.8.2",
    "signal-polyfill": "0.2.2",
    "typescript": "^7.0.2",
    "vscode-html-languageservice": "5.6.2",
    "vscode-languageserver-textdocument": "1.0.16",
    "vue": "3.5.45"
  },
  "files": [
    "src",
    "dist",
    "fesm2022",
    "types"
  ]
}
