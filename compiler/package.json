{
  "name": "@mnx/compiler",
  "version": "3.4.0",
  "description": "The mnx compiler as WebAssembly: compile .mnx components from Node without installing Rust",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/journey-to-code-org/open.mnx.git",
    "directory": "compiler"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./library": {
      "types": "./library.d.ts",
      "default": "./library.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "mnx.wasm",
    "cli.js",
    "library.js",
    "library.d.ts",
    "registry"
  ],
  "scripts": {
    "build": "cargo build -p mnx-wasm --target wasm32-unknown-unknown --release && cp ../target/wasm32-unknown-unknown/release/mnx_wasm.wasm mnx.wasm",
    "test": "node --test \"test/*.test.js\"",
    "prepack": "node -e \"const fs=require('fs');fs.rmSync('registry',{recursive:true,force:true});fs.cpSync('../registry','registry',{recursive:true,filter:(p)=>!/[\\\\/](test|node_modules)([\\\\/]|$)/.test(p)})\""
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mnx": "./cli.js"
  }
}
