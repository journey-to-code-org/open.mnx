{
  "name": "@zubra/compiler",
  "version": "5.6.0",
  "description": "The Zubra compiler as WebAssembly: compile .zb components from Node without installing Rust",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/journey-to-code-org/zubra.git",
    "directory": "compiler"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./wasm": {
      "types": "./core.d.ts",
      "default": "./core.js"
    },
    "./zubra.wasm": "./zubra.wasm",
    "./library": {
      "types": "./library.d.ts",
      "default": "./library.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "core.js",
    "core.d.ts",
    "zubra.wasm",
    "cli.js",
    "library.js",
    "library.d.ts",
    "registry",
    "!registry/test"
  ],
  "scripts": {
    "build": "cargo build -p zubra-wasm --target wasm32-unknown-unknown --release && cp ../target/wasm32-unknown-unknown/release/zubra_wasm.wasm zubra.wasm",
    "test": "node --test \"test/*.test.js\"",
    "prepack": "node scripts/prepack.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "zubra": "cli.js"
  }
}
