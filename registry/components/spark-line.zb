<!--
  A small line of recent values, green when it ends higher than it started, red when lower.
-->
<script>
  const low = Math.min(...points)
  const high = Math.max(...points)
  const span = high - low || 1
  const path = points.map((value, index) => `${(index / Math.max(1, points.length - 1)) * 100},${28 - ((value - low) / span) * 26}`).join(" ")
  const trend = points.length < 2 ? "flat" : points[points.length - 1] >= points[0] ? "up" : "down"
</script>
<style>
  :host { display: block; height: 2rem; }
  svg { display: block; width: 100%; height: 100%; overflow: visible; }
  polyline { fill: none; stroke-width: 1.6; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .up { stroke: var(--up, #12805c); } .down { stroke: var(--down, #c4320a); } .flat { stroke: var(--muted, #667085); }
</style>
<spark-line points={[]} label="Trend">
  <svg viewBox="0 0 100 30" preserveAspectRatio="none" role="img" aria-label={`${label}: ${trend}`}><polyline class={trend} points={path}></polyline></svg>
</spark-line>
