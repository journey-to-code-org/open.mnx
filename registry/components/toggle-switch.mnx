<!--
  An on/off switch with a label and a description. A form control (submits "on" when checked).
  @fires checkedchange - It was switched; `detail` is the new state.
-->
<script>
  function toggle() {
    checked = !checked
  }
</script>
<style>
  :host { display: block; }
  button { display: flex; align-items: center; gap: 0.9rem; width: 100%; padding: 0.75rem 0.9rem; border: 1px solid var(--line, #dde); border-radius: 0.8rem; background: var(--surface, #fff); color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .track { flex: none; width: 2.6rem; height: 1.5rem; border-radius: 999px; background: var(--line, #ccd); position: relative; transition: background 0.2s; }
  .track::after { content: ""; position: absolute; top: 0.2rem; left: 0.2rem; width: 1.1rem; height: 1.1rem; border-radius: 50%; background: white; box-shadow: 0 1px 2px #0003; transition: transform 0.2s; }
  [aria-checked=true] .track { background: var(--accent, #36c); }
  [aria-checked=true] .track::after { transform: translateX(1.1rem); }
  .text { display: grid; flex: 1; }
  small { color: var(--muted, #667); }
  .extra { font-weight: 700; white-space: nowrap; }
</style>
<toggle-switch form-associated checked:model={false} label="" description="" extra="">
  <button type="button" role="switch" aria-checked={checked ? "true" : "false"} onclick={toggle}>
    <span class="track"></span>
    <span class="text"><span class="label">{label}</span><small>{description}</small></span>
    <span class="extra">{extra}</span>
  </button>
</toggle-switch>
