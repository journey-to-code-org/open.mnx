{
  "name": "zubra-compared-coexist",
  "private": true,
  "type": "module",
  "description": "One design system, four hosts and a server page, built four times: in Zubra, Lit, Stencil and Enhance. One test suite drives all of them, and measure.mjs reports what each costs (README.md).",
  "scripts": {
    "build:stencil": "stencil build --config impl/stencil/stencil.config.ts",
    "pretest": "npm run build:stencil",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "measure": "node measure.mjs"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.6",
    "@angular/build": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@enhance/base-element": "1.3.2",
    "@enhance/ssr": "4.0.3",
    "@lit-labs/ssr": "4.1.0",
    "@lit-labs/ssr-client": "1.1.8",
    "@lit/react": "1.0.8",
    "@stencil/core": "4.45.3",
    "@stencil/react-output-target": "1.8.1",
    "@stencil/vue-output-target": "0.15.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@zubra/compiler": "5.14.0",
    "@zubra/runtime": "5.14.0",
    "@zubra/server": "5.14.0",
    "@zubra/unplugin": "5.14.0",
    "esbuild": "0.28.2",
    "lit": "3.3.3",
    "morphdom": "2.7.8",
    "playwright": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "svelte": "5.57.3",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vue": "3.5.45"
  }
}
