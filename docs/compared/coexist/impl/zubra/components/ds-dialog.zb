<!--
  A modal dialog on the native <dialog>. `open` is two-way: Escape and the close button set it
  to false.
  @slot - The dialog's content.
  @fires openchange - The dialog opened or closed; `detail` is whether it is open.
-->
<script>
  import { effect, id } from '@zubra/runtime'
  const headingId = id()
  let dialog = null
  effect(() => {
    if (!dialog) return
    if (open && !dialog.open) dialog.showModal()
    else if (!open && dialog.open) dialog.close()
  })
</script>
<style>
  dialog { border: 0; border-radius: 0.8rem; padding: 1.25rem; width: min(26rem, calc(100vw - 2rem)); box-shadow: 0 24px 64px #0d122040; }
  dialog::backdrop { background: #0d122066; }
  header { display: flex; align-items: center; gap: 1rem; }
  h2 { flex: 1; margin: 0; font-size: 1.1rem; }
  header button { border: 0; background: none; font-size: 1.4rem; line-height: 1; cursor: pointer; }
</style>
<ds-dialog open:model={false} heading="">
  <dialog ref={dialog} aria-labelledby={headingId} onclose={() => (open = false)}>
    <header>
      <h2 id={headingId}>{heading}</h2>
      <button type="button" aria-label="Close" onclick={() => (open = false)}>×</button>
    </header>
    <zb-slot></zb-slot>
  </dialog>
</ds-dialog>
