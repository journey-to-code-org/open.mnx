<!-- An order's status, as a coloured label. Nothing in it changes, so it needs no script in the browser. -->
<script>
  const text = status.slice(0, 1).toUpperCase() + status.slice(1)
</script>
<style>
  span { display: inline-block; padding: 0.1rem 0.5rem; border-radius: 1rem; font-size: 0.8rem; font-weight: 600; background: #eef0f4; }
  span[data-status=shipped] { background: #dcf5e4; color: #14602f; }
  span[data-status=cancelled] { background: #fde3e1; color: #8f1d14; }
</style>
<ds-badge status="pending">
  <span data-status={status}>{text}</span>
</ds-badge>
