<!--
  A number with − and + buttons. It's a native `<input type="number">` in the page, so it
  submits (and validates its range) without JavaScript; the buttons appear once the element
  is live, since they need it.
  @fires valuechange - The number changed; `detail` is the new one.
-->
<script>
  import { hydrated } from '@zubra/runtime'

  const live = hydrated()
  const round = (number) => Math.round(number * 100) / 100
  const nudge = (by) => (value = round(Math.min(max, Math.max(min, Number(value) + by))))
</script>
<style>
  :host { display: grid; gap: 0.3rem; }
  span.label { font-weight: 600; }
  div { display: flex; align-items: center; gap: 0.3rem; }
  input { width: 5.5rem; padding: 0.45rem 0.6rem; font: inherit; border: 1px solid #d9dccf; border-radius: 0.5rem; text-align: center; }
  button { width: 2.2rem; height: 2.2rem; font: inherit; font-size: 1.1rem; border: 1px solid #d9dccf; border-radius: 0.5rem; background: white; cursor: pointer; }
  button:disabled { opacity: 0.4; cursor: default; }
  small { color: #6b705f; }
</style>
<number-field name="value" value:model={1} min={0} max={100} step={1} label="Amount" unit="">
  <label for={name}><span class="label">{label}</span></label>
  <div>
    <button zb-if={live} type="button" aria-label={"Less " + label} disabled={value <= min} onclick={() => nudge(0 - step)}>−</button>
    <input id={name} type="number" name={name} value={value} min={min} max={max} step={step} required
           oninput={(event) => (value = event.target.valueAsNumber)}>
    <button zb-if={live} type="button" aria-label={"More " + label} disabled={value >= max} onclick={() => nudge(step)}>+</button>
    <small>{unit}</small>
  </div>
</number-field>
