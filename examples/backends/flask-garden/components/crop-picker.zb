<!--
  Pick up to `max` crops. Native checkboxes in the page (light DOM), so the choice submits with
  its form before any JavaScript; in the browser the count updates as you pick, and the boxes
  you can't add any more to are disabled.
  `options` is `[{ value, label }]`.
  @fires valuechange - The chosen crops changed; `detail` is their values.
-->
<script>
  import { hydrated } from '@zubra/runtime'

  const live = hydrated()
  function toggle(event, crop) {
    value = event.target.checked ? [...value, crop] : value.filter((item) => item !== crop)
  }
</script>
<style>
  fieldset { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; border: 0; }
  legend { width: 100%; margin-bottom: 0.35rem; font-weight: 600; }
  legend small { font-weight: 400; color: #6b705f; }
  legend small.full { color: #7a5420; font-weight: 600; }
  label { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.7rem; border: 1px solid #d9dccf; border-radius: 999px; background: white; cursor: pointer; }
  label:has(input:checked) { border-color: #3b7d3f; background: #e3f4e1; font-weight: 600; }
  label:has(input:disabled) { opacity: 0.5; cursor: default; }
  label:has(input:focus-visible) { outline: 2px solid #3b7d3f; outline-offset: 1px; }
</style>
<crop-picker name="crops" value:model={[]} options={[]} max={3} legend="Crops">
  <fieldset>
    <legend>{legend} <small class:full={value.length >= max}>{value.length} of {max}</small></legend>
    <zb-each items={options} as="option" key={option.value}>
      <label>
        <input type="checkbox" name={name} value={option.value} checked={value.includes(option.value)}
               disabled={live && value.length >= max && !value.includes(option.value)}
               onchange={(event) => toggle(event, option.value)}>
        {option.label}
      </label>
    </zb-each>
  </fieldset>
</crop-picker>
