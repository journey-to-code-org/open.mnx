<!-- A ticket's status as a coloured badge. -->
<style>
  .badge { display: inline-block; padding: 0.1rem 0.55rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; text-transform: capitalize; background: #eef0f5; color: #3d4356; }
  .badge[data-status=open] { background: #e3edff; color: #1d4ed8; }
  .badge[data-status=pending] { background: #fff1d6; color: #9a5b00; }
  .badge[data-status=solved] { background: #dcf5e7; color: #12704a; }
</style>
<status-badge status="open"><span class="badge" data-status={status}>{status}</span></status-badge>
