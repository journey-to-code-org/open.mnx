<!--
  The reply box. It owns its form, which posts to `reply`, a 'use server' function: a native
  post without JavaScript, a fetch with it (@zubra/actions). In the browser it counts
  characters, disables Send while empty, and Ctrl+Enter (⌘+Enter) sends. Agents also get
  "internal note", a checkbox that submits with the form.
-->
<script>
  import { hydrated } from '@zubra/runtime'
  import { addReply } from '../src/replies.js'

  let text = ""
  let problem = ""
  const live = hydrated()

  // Runs on the server only: the browser module gets its URL instead.
  export async function reply(formData, context) {
    'use server'
    const done = await addReply(context, formData)
    if (done.error) return done
    return Response.redirect(new URL(`/tickets/${done.id}#latest`, context.request.url), 303)
  }
</script>
<style>
  :host, form { display: grid; gap: 0.5rem; }
  .problem { margin: 0; color: #c62f3f; }
  textarea { width: 100%; min-height: 7rem; box-sizing: border-box; padding: 0.7rem 0.8rem; font: inherit; line-height: 1.5; border: 1px solid #d6dae3; border-radius: 0.6rem; resize: vertical; }
  textarea:focus { outline: 2px solid #4f5df5; outline-offset: 0; }
  .row { display: flex; align-items: center; gap: 1rem; }
  .count { margin-left: auto; color: #8a90a0; font-size: 0.8rem; font-variant-numeric: tabular-nums; }
  .count.over { color: #c62f3f; font-weight: 700; }
  button { font: inherit; padding: 0.5rem 1.1rem; border: 0; border-radius: 0.5rem; background: #4f5df5; color: white; font-weight: 600; cursor: pointer; }
  button:disabled { opacity: 0.45; cursor: default; }
  label { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.9rem; }
</style>
<reply-composer ticket={0} name="body" label="Reply" agent={false} max={4000}>
  <form
    action={reply}
    onaction={(event) => (problem = event.detail.value?.error ?? event.detail.error ?? "")}
  >
    <input type="hidden" name="ticket" value={ticket}>
    <textarea
      name={name}
      aria-label={label}
      required
      maxlength={max}
      placeholder="Write a reply…"
      oninput={(event) => (text = event.target.value)}
      onkeydown.mod.enter.prevent.submit
    ></textarea>
    <div class="row">
      <label zb-if={agent}><input type="checkbox" name="internal" value="on"> Internal note</label>
      <span zb-if={live} class="count" class:over={text.length > max}>{text.length}/{max}</span>
      <button disabled={live && text.trim() === ""}>Send</button>
    </div>
    <p zb-if={problem} class="problem" role="alert">{problem}</p>
  </form>
</reply-composer>
