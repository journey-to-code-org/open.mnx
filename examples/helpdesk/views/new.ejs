<section class="narrow">
  <h1>New ticket</h1>
  <form method="post" action="/tickets" class="stack" novalidate>
    <label class="field">Subject
      <input name="subject" value="<%= values.subject %>" maxlength="120" required aria-invalid="<%= errors.subject ? 'true' : 'false' %>" <% if (errors.subject) { %>aria-describedby="subject-error"<% } %>>
      <% if (errors.subject) { %><span class="error" id="subject-error"><%= errors.subject %></span><% } %>
    </label>
    <%- mnx('priority-picker', { name: 'priority', value: values.priority, legend: 'How urgent is it?' }) %>
    <label class="field">What's happening?
      <textarea name="body" rows="7" required aria-invalid="<%= errors.body ? 'true' : 'false' %>"><%= values.body %></textarea>
      <% if (errors.body) { %><span class="error"><%= errors.body %></span><% } %>
    </label>
    <div><button class="button">Create ticket</button></div>
  </form>
</section>
