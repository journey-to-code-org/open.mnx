<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Help desk</title>
  <link rel="stylesheet" href="/app.css">
  <%# @zubra/server adds the CSS of the components this page rendered here, and their modules at the end of the body. %>
</head>
<body>
  <header class="top">
    <a class="brand" href="/">Help desk</a>
    <% if (user) { %>
      <nav aria-label="Main">
        <a href="/">Home</a>
        <a href="/tickets">Tickets</a>
        <a href="/tickets/new">New ticket</a>
      </nav>
      <form method="post" action="/logout" class="who">
        <span><%= user.name %> <small><%= user.role %></small></span>
        <button>Sign out</button>
      </form>
    <% } %>
  </header>
  <main>
<%- body %>
  </main>
  <%- actionsScript %>
</body>
</html>
