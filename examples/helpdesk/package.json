{
  "name": "mnx-example-helpdesk",
  "private": true,
  "type": "module",
  "description": "A help-desk ticket tracker: Express, EJS and MongoDB, with mnx components rendered on the server and hydrated in the browser.",
  "scripts": {
    "prestart": "node scripts/ensure-compiler.js",
    "start": "node server.js",
    "pretest": "node scripts/ensure-compiler.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@mnx/compiler": "file:../../compiler",
    "@mnx/runtime": "file:../../runtime",
    "@mnx/server": "file:../../server",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "mongodb": "7.8.0"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
