<!--
  One to-do item, editable in place.
  @fires toggle - The checkbox was clicked.
  @fires rename - Edited; `detail` is the new text.
  @fires remove - The remove button was clicked.
-->
<script>
  import { emit } from '@mnx/runtime'

  let editing = false
  let draft = ""

  function edit() {
    draft = text
    editing = true
  }
  function save(event) {
    event?.preventDefault()
    if (!editing) return
    editing = false
    const next = draft.trim()
    if (next && next !== text) emit('rename', next)
  }
</script>
<style>
  :host { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem; }
  label { flex: 1; display: flex; align-items: center; gap: 0.5rem; }
  .done { text-decoration: line-through; opacity: 0.6; }
  form { flex: 1; display: flex; }
  form input { flex: 1; font: inherit; padding: 0.2rem 0.4rem; }
  .remove { border: 0; background: none; font-size: 1.1rem; cursor: pointer; opacity: 0.5; }
  .remove:hover { opacity: 1; }
</style>
<todo-item text done={false}>
  <mnx-if test={editing}>
    <form onsubmit={save}>
      <input aria-label="Edit item" value={draft} oninput={(event) => (draft = event.target.value)} onblur={save}>
    </form>
    <mnx-else>
      <label>
        <input type="checkbox" checked={done} onchange={() => emit('toggle')}>
        <span class={done ? "done" : ""} ondblclick={edit}>{text}</span>
      </label>
      <button type="button" class="remove" aria-label="Remove {text}" onclick={() => emit('remove')}>×</button>
    </mnx-else>
  </mnx-if>
</todo-item>
