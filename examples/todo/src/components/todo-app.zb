<!--
  A to-do list: add, complete, edit, remove, filter and clear items.
  @fires change - The list changed; `detail` is the new list.
-->
<script>
  import { emit } from '@zubra/runtime'
  import './todo-item.zb'

  // Props are names in the script: `items` is the prop, readable and writable.
  let filter = "all"
  let draft = ""
  // Derived from props and state, so they stay in sync.
  const remaining = items.filter((item) => !item.done).length
  const shown = filter === "all" ? items : items.filter((item) => item.done === (filter === "done"))

  function update(next) {
    items = next
    emit('change', items)
  }
  function add() {
    const text = draft.trim()
    if (!text) return
    const id = Math.max(0, ...items.map((item) => item.id)) + 1
    update([...items, { id, text, done: false }])
    draft = ""
  }
  const toggle = (id) => update(items.map((item) => (item.id === id ? { ...item, done: !item.done } : item)))
  const rename = (id, text) => update(items.map((item) => (item.id === id ? { ...item, text } : item)))
  const remove = (id) => update(items.filter((item) => item.id !== id))
  const clearDone = () => update(items.filter((item) => !item.done))
</script>
<style>
  :host { display: block; border: 1px solid #8884; border-radius: 0.75rem; overflow: hidden; }
  form { display: flex; gap: 0.5rem; padding: 0.75rem; border-bottom: 1px solid #8884; }
  form input { flex: 1; font: inherit; padding: 0.4rem 0.6rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li + li { border-top: 1px solid #8882; }
  footer { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem; font-size: 0.875rem; border-top: 1px solid #8884; }
  footer .count { margin-right: auto; }
  footer button { font: inherit; background: none; border: 1px solid transparent; border-radius: 0.375rem; padding: 0.15rem 0.5rem; cursor: pointer; }
  footer button.on { border-color: currentColor; }
  .empty { padding: 1rem 0.75rem; opacity: 0.6; }
</style>
<todo-app items={[{ id: 1, text: "Try zubra 2.0", done: true }, { id: 2, text: "Write a component", done: false }]}>
  <form onsubmit.prevent={add}>
    <input aria-label="New item" placeholder="What needs doing?" value={draft} oninput={(event) => (draft = event.target.value)}>
    <button type="submit">Add</button>
  </form>
  <zb-if test={shown.length > 0}>
    <ul>
      <zb-each items={shown} as="item" key={item.id}>
        <li>
          <todo-item text={item.text} done={item.done} ontoggle={() => toggle(item.id)} onrename={(event) => rename(item.id, event.detail)} onremove={() => remove(item.id)}></todo-item>
        </li>
      </zb-each>
    </ul>
    <zb-else><p class="empty">Nothing here.</p></zb-else>
  </zb-if>
  <footer>
    <span class="count">{remaining} left</span>
    <button type="button" class:on={filter === "all"} onclick={() => (filter = "all")}>All</button>
    <button type="button" class:on={filter === "open"} onclick={() => (filter = "open")}>Open</button>
    <button type="button" class:on={filter === "done"} onclick={() => (filter = "done")}>Done</button>
    <button type="button" onclick={clearDone}>Clear done</button>
  </footer>
</todo-app>
