<!--
  An amount of money. Typing is free-form; on blur it's formatted (`1234.5` → `1,234.50`). The
  value is a number (or null when empty). A form control: `required` and `min` validate it.
  @fires valuechange - The amount changed; `detail` is the number, or null.
-->
<script>
  import { validity } from '@zubra/runtime'

  const format = (amount) => (amount == null ? "" : amount.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }))
  let text = format(value)
  let focused = false
  const shown = focused ? text : format(value)

  validity(() => (required && value == null ? "Enter an amount" : value != null && value < min ? `At least ${format(min)}` : ""))

  function input(event) {
    text = event.target.value
    const cleaned = text.replace(/[^0-9.]/g, "")
    const next = cleaned === "" || isNaN(Number(cleaned)) ? null : Math.round(Number(cleaned) * 100) / 100
    if (next === value) return
    value = next
  }
  // While focused the text is left as typed; on blur it's formatted again.
  function focus() {
    text = format(value)
    focused = true
  }
</script>
<style>
  :host { display: block; }
  .box { display: flex; align-items: center; border: 1px solid var(--line, #d9dce3); border-radius: 0.6rem; background: var(--surface, #ffffff); }
  .box:focus-within { outline: 2px solid var(--accent, #4f5df5); outline-offset: 1px; }
  span { padding-left: 0.7rem; color: var(--muted, #667085); font-weight: 600; }
  input { flex: 1; min-width: 0; padding: 0.55rem 0.7rem 0.55rem 0.3rem; border: 0; outline: 0; background: none; font: inherit; font-variant-numeric: tabular-nums; color: inherit; text-align: right; }
</style>
<money-input
  shadow
  form-associated
  value:model={null}
  symbol="$"
  required={false}
  min={0}
  label="Amount"
>
  <div class="box">
    <span aria-hidden="true">{symbol}</span>
    <input
      inputmode="decimal"
      autocomplete="off"
      aria-label={label}
      placeholder="0.00"
      value={shown}
      oninput={input}
      onfocus={focus}
      onblur={() => (focused = false)}
    >
  </div>
</money-input>
