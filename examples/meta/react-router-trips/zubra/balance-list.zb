<!--
  Who's up and who's down: a bar per person, out from a centre line (green paid more than their
  share, red less), with the amount. `balances` is `[{ name, cents }]`, positive when owed.
-->
<script>
  const most = Math.max(1, ...balances.map((person) => Math.abs(person.cents)))
  const money = (cents) => (cents < 0 ? "−$" : "$") + (Math.abs(cents) / 100).toFixed(2)
</script>
<style>
  ul { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  li { display: grid; grid-template-columns: 5rem 1fr 5.5rem; align-items: center; gap: 0.6rem; }
  .track { position: relative; height: 0.8rem; border-radius: 0.4rem; background: #eef0f4; }
  .track::after { content: ""; position: absolute; left: 50%; top: -0.2rem; bottom: -0.2rem; width: 1px; background: #b8bdc9; }
  .bar { position: absolute; top: 0; bottom: 0; border-radius: 0.4rem; }
  .bar.up { left: 50%; background: #2f9e44; }
  .bar.down { right: 50%; background: #e03131; }
  .amount { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }
  .amount.down { color: #c92a2a; }
</style>
<balance-list balances={[]}>
  <ul>
    <zb-each items={balances} as="person" key={person.name}>
      <li>
        <span>{person.name}</span>
        <span class="track" role="img" aria-label={person.name + ": " + money(person.cents)}>
          <span
            class="bar"
            class:up={person.cents >= 0}
            class:down={person.cents < 0}
            style:width={(Math.abs(person.cents) / most) * 50 + "%"}
          ></span>
        </span>
        <span class="amount" class:down={person.cents < 0}>{money(person.cents)}</span>
      </li>
    </zb-each>
  </ul>
</balance-list>
