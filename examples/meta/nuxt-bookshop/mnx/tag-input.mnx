<!--
  A list of tags you type: Enter or comma adds one, Backspace in the empty field removes the
  last, × removes any. Suggestions come from `suggestions`. A form control.
  @fires valuechange - The tags changed; `detail` is the new array.
-->
<script>
  import { formValue, id } from '@mnx/runtime'

  const listId = id()
  let draft = ""
  const offered = suggestions.filter((tag) => !value.includes(tag))

  formValue(() => value.join(","))

  function set(next) {
    value = next
  }
  function add(text) {
    const tag = text.trim().toLowerCase().replace(/\s+/g, "-")
    draft = ""
    if (tag && !value.includes(tag) && value.length < max) set([...value, tag])
  }
  function key(event) {
    if (event.key === 'Enter' || event.key === ',') {
      event.preventDefault()
      add(draft)
    } else if (event.key === 'Backspace' && !draft && value.length) {
      set(value.slice(0, -1))
    }
  }
</script>
<style>
  :host { display: block; }
  .box { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; padding: 0.35rem 0.4rem; border: 1px solid var(--line, #d9dce3); border-radius: 0.6rem; background: var(--surface, #ffffff); }
  .box:focus-within { outline: 2px solid var(--accent, #4f5df5); outline-offset: 1px; }
  .tag { display: inline-flex; align-items: center; gap: 0.15rem; padding: 0.1rem 0.2rem 0.1rem 0.5rem; border-radius: 0.4rem; background: var(--chip, #eceefe); color: var(--chip-ink, #3a3f9e); font-size: 0.8125rem; font-weight: 600; }
  .tag button { border: 0; background: none; color: inherit; padding: 0 0.25rem; cursor: pointer; font: inherit; }
  input { flex: 1; min-width: 7rem; border: 0; outline: 0; padding: 0.3rem; font: inherit; background: none; color: inherit; }
  .hint { margin: 0.3rem 0 0; font-size: 0.75rem; color: var(--muted, #667085); }
</style>
<tag-input shadow form-associated value:model={[]} suggestions={[]} max={6} label="Tags">
  <div class="box">
    <mnx-each items={value} as="tag" key={tag}>
      <span class="tag">{tag}<button type="button" aria-label={`Remove ${tag}`} onclick={() => set(value.filter((item) => item !== tag))}>×</button></span>
    </mnx-each>
    <input aria-label={label} list={listId} placeholder={value.length >= max ? "" : "Add a tag…"} disabled={value.length >= max} value={draft} oninput={(event) => (draft = event.target.value)} onkeydown={key} onchange={(event) => offered.includes(event.target.value) && add(event.target.value)}>
    <datalist id={listId}><mnx-each items={offered} as="tag" key={tag}><option value={tag}></option></mnx-each></datalist>
  </div>
  <p class="hint">{value.length}/{max} · Enter or comma to add</p>
</tag-input>
