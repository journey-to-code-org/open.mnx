{
  "name": "zubra-example-eleventy-trails",
  "private": true,
  "type": "module",
  "description": "A static trail guide built with Eleventy: Zubra components rendered to HTML at build time by a shortcode, and hydrated in the browser with no bundler.",
  "scripts": {
    "build": "eleventy",
    "start": "eleventy --serve",
    "pretest": "eleventy --quiet",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.8",
    "@zubra/compiler": "file:../../../compiler",
    "@zubra/runtime": "file:../../../runtime",
    "@zubra/server": "file:../../../server"
  },
  "devDependencies": {
    "html-minifier-terser": "7.2.0",
    "playwright": "1.63.0"
  }
}
