<!--
  A trail in the list: its name (a link), difficulty, length in the chosen units, and climb.
  `units` is "km" or "mi"; the page switches it on every card at once.
-->
<script>
  import './difficulty-badge.mnx'
</script>
<style>
  article { display: grid; gap: 0.35rem; padding: 0.9rem 1rem; background: white; border: 1px solid #e0e4da; border-radius: 0.7rem; }
  h3 { margin: 0; font-size: 1.05rem; }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .facts { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; color: #5d6758; font-size: 0.85rem; font-variant-numeric: tabular-nums; }
  p { margin: 0; color: #3b4237; font-size: 0.9rem; }
</style>
<trail-card name="" href="" difficulty="easy" km={0} mi={0} climb={0} units="km" summary="">
  <article>
    <h3><a href={href}>{name}</a></h3>
    <div class="facts">
      <difficulty-badge level={difficulty}></difficulty-badge>
      <span class="length">{units === "mi" ? mi + " mi" : km + " km"}</span>
      <span>↑ {units === "mi" ? (climb * 3.28084 - (climb * 3.28084) % 1) + " ft" : climb + " m"}</span>
    </div>
    <p>{summary}</p>
  </article>
</trail-card>
