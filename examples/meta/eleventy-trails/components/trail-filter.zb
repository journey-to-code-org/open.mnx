<!--
  Filter the list by difficulty and length. It only exists once JavaScript runs (filtering needs
  it), so the page without JavaScript simply lists every trail.
  @fires filterchange - The filter changed; `detail` is `{ levels, longest }`.
-->
<script>
  import { emit, from, hydrated, raw } from '@zubra/runtime'

  const LEVELS = ['easy', 'moderate', 'hard']
  let levels = [...LEVELS]
  let longest = from(max) // the slider starts at the longest trail, and again if that changes
  const live = hydrated()
  function toggle(level, on) {
    if (on) levels.push(level)
    else levels.splice(levels.indexOf(level), 1)
    emit('filterchange', { levels: raw(levels), longest })
  }
  function setLongest(value) {
    longest = value
    emit('filterchange', { levels: raw(levels), longest })
  }
</script>
<style>
  fieldset { display: flex; flex-wrap: wrap; gap: 0.6rem 1.2rem; align-items: center; margin: 0; padding: 0.8rem 1rem; background: white; border: 1px solid #e0e4da; border-radius: 0.7rem; }
  legend { padding: 0 0.3rem; font-weight: 700; }
  label { display: inline-flex; align-items: center; gap: 0.35rem; text-transform: capitalize; }
  output { min-width: 3.5rem; font-variant-numeric: tabular-nums; }
</style>
<trail-filter max={40} units="km">
  <fieldset zb-if={live}>
      <legend>Filter</legend>
      <zb-each items={LEVELS} as="level" key={level}>
        <label><input type="checkbox" checked={levels.includes(level)} onchange={(event) => toggle(level, event.target.checked)}> {level}</label>
      </zb-each>
      <label>Up to <input type="range" min="1" max={max} value={longest} aria-label="Longest" oninput={(event) => setLongest(event.target.valueAsNumber)}> <output>{longest} km</output></label>
    </fieldset>
</trail-filter>
