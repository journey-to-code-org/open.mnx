<!--
  Who's bringing what: a column per course with a count against what's needed, and the names.
  `courses` is `[{ id, title, need, people: [{ name, guests }] }]`.
-->
<style>
  :host { display: block; }
  ol { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 0.6rem; margin: 0; padding: 0; list-style: none; }
  li { padding: 0.7rem; background: white; border: 1px solid #e6e1d8; border-radius: 0.6rem; }
  h3 { display: flex; justify-content: space-between; margin: 0 0 0.4rem; font-size: 0.95rem; }
  h3 small { color: #7b7466; font-weight: 400; font-variant-numeric: tabular-nums; }
  meter { width: 100%; height: 0.5rem; }
  ul { margin: 0.4rem 0 0; padding: 0; list-style: none; font-size: 0.85rem; color: #4b463c; }
  .open { color: #9a5b00; font-size: 0.8rem; }
</style>
<dish-board courses={[]}>
  <ol>
    <mnx-each items={courses} as="course" key={course.id}>
      <li data-course={course.id}>
        <h3>{course.title} <small>{course.people.length} of {course.need}</small></h3>
        <meter min="0" max={course.need} value={course.people.length} aria-label={course.title + ": " + course.people.length + " of " + course.need}></meter>
        <ul>
          <mnx-each items={course.people} as="person" key={person.name}><li>{person.name}{person.guests > 1 ? " +" + (person.guests - 1) : ""}</li></mnx-each>
        </ul>
        <mnx-if test={course.people.length < course.need}><p class="open">{course.need - course.people.length} still needed</p></mnx-if>
      </li>
    </mnx-each>
  </ol>
</dish-board>
