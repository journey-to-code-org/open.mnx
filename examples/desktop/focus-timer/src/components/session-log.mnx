<!--
  Today's finished sessions: a dot per session, the total, and what each was for.
  `sessions` is `[{ id, mode, task, seconds, at }]`, oldest first.
-->
<script>
  const focus = sessions.filter((session) => session.mode === 'focus')
  const total = Math.round(focus.reduce((sum, session) => sum + session.seconds, 0) / 60)
  const time = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' })
</script>
<style>
  :host { display: grid; gap: 0.6rem; }
  h2 { margin: 0; font-size: 0.95rem; }
  .dots { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .dot { width: 0.8rem; height: 0.8rem; border-radius: 50%; background: var(--accent, #d9480f); }
  .dot.break { background: var(--calm, #2b8a3e); width: 0.55rem; height: 0.55rem; align-self: center; }
  ol { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.25rem; font-size: 0.85rem; }
  li { display: flex; gap: 0.5rem; }
  li time { color: var(--muted, #6a7186); font-variant-numeric: tabular-nums; min-width: 4.5rem; }
  p { margin: 0; color: var(--muted, #6a7186); }
</style>
<session-log sessions={[]}>
  <h2>Today: {focus.length} {focus.length === 1 ? "session" : "sessions"}, {total} min</h2>
  <div class="dots" aria-hidden="true">
    <mnx-each items={sessions} as="session" key={session.id}><span class="dot" class:break={session.mode !== 'focus'}></span></mnx-each>
  </div>
  <mnx-if test={focus.length > 0}>
    <ol>
      <mnx-each items={focus} as="session" key={session.id}>
        <li><time datetime={new Date(session.at).toISOString()}>{time.format(session.at)}</time><span>{session.task || "Focus"}</span></li>
      </mnx-each>
    </ol>
    <mnx-else><p>Nothing yet. Start a session.</p></mnx-else>
  </mnx-if>
</session-log>
