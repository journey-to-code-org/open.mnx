<!--
  A countdown for one focus session or break: the ring, the time left, and Start / Pause /
  Reset. Space starts and pauses. When it reaches zero it fires `done` and stops.
  @slot - What's being timed (under the time).
  @fires done - The time ran out; `detail` is the session's length in seconds.
  @fires running - It started or paused; `detail` is whether it's running.
-->
<script>
  import { emit, from, onMount } from '@mnx/runtime'
  import './progress-ring.mnx'

  // A new length (the app switched modes) starts over, stopped.
  let left = from(seconds)
  let running = from(seconds, false)
  let ends = 0
  const minutes = String(Math.floor(left / 60)).padStart(2, '0')
  const rest = String(left % 60).padStart(2, '0')

  function tick() {
    if (!running) return
    left = Math.max(0, Math.round((ends - Date.now()) / 1000))
    if (left === 0) {
      running = false
      emit('running', false)
      emit('done', seconds)
    }
  }
  function toggle() {
    if (left === 0) left = seconds
    running = !running
    if (running) ends = Date.now() + left * 1000
    emit('running', running)
  }
  function reset() {
    running = false
    left = seconds
    emit('running', false)
  }
  onMount(() => {
    const timer = setInterval(tick, 250)
    return () => clearInterval(timer)
  })
</script>
<style>
  :host { display: grid; justify-items: center; gap: 1rem; }
  progress-ring { --size: 13rem; }
  time { display: block; font-size: 2.6rem; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }
  .what { color: var(--muted, #6a7186); font-size: 0.85rem; }
  .buttons { display: flex; gap: 0.5rem; }
  button { min-width: 6rem; padding: 0.55rem 1rem; font: inherit; font-weight: 600; border: 1px solid var(--line, #d7dae3); border-radius: 0.6rem; background: var(--surface, white); color: inherit; cursor: pointer; }
  button.primary { background: var(--accent, #d9480f); border-color: transparent; color: white; }
</style>
<focus-timer seconds={1500}>
  <mnx-document onkeydown.space.prevent={toggle}></mnx-document>
  <progress-ring value={seconds - left} max={seconds} label="Time elapsed">
    <div>
      <time datetime={"PT" + left + "S"}>{minutes}:{rest}</time>
      <div class="what"><mnx-slot></mnx-slot></div>
    </div>
  </progress-ring>
  <div class="buttons">
    <button type="button" class="primary" onclick={toggle}>{running ? "Pause" : left === 0 ? "Again" : "Start"}</button>
    <button type="button" onclick={reset} disabled={!running && left === seconds}>Reset</button>
  </div>
</focus-timer>
