<!--
  A count with − and + buttons, for stock. It's a native `<input type="number">` in light DOM,
  so it submits with its form, by a plain post or by htmx (`hx-put` reads the form's fields);
  the buttons appear once the element is live.
  @fires valuechange - The count changed; `detail` is the new one.
-->
<script>
  import { onMount } from '@mnx/runtime'

  let live = false
  onMount(() => (live = true))
  const nudge = (by) => (value = Math.min(max, Math.max(min, Number(value) + by)))
</script>
<style>
  :host { display: inline-flex; align-items: center; gap: 0.25rem; }
  input { width: 4.2rem; padding: 0.3rem 0.4rem; font: inherit; text-align: center; border: 1px solid #cfd4de; border-radius: 0.4rem; }
  button { width: 1.9rem; height: 1.9rem; font: inherit; border: 1px solid #cfd4de; border-radius: 0.4rem; background: white; cursor: pointer; }
  button:disabled { opacity: 0.4; }
</style>
<qty-input name="count" value:model={0} min={0} max={999} label="Count">
  <mnx-if test={live}><button type="button" aria-label={"Fewer: " + label} disabled={value <= min} onclick={() => nudge(-1)}>−</button></mnx-if>
  <input type="number" name={name} aria-label={label} value={value} min={min} max={max} required oninput={(event) => (value = event.target.valueAsNumber)}>
  <mnx-if test={live}><button type="button" aria-label={"More: " + label} disabled={value >= max} onclick={() => nudge(1)}>+</button></mnx-if>
</qty-input>
