<!--
  A price from whole cents, as dollars: 129900 → $1,299.00. Pure arithmetic, so the server
  renders it completely (the server's renderer doesn't run `Intl.NumberFormat`).
-->
<script>
  const dollars = (cents - cents % 100) / 100
  const thousands = (dollars - dollars % 1000) / 1000
  const rest = dollars % 1000
  const change = cents % 100
</script>
<style>
  data { font-variant-numeric: tabular-nums; font-weight: 600; }
</style>
<price-tag cents={0}>
  <data value={cents / 100}>${thousands > 0 ? thousands + "," + (rest < 100 ? "0" : "") + (rest < 10 ? "0" : "") + rest : rest}.{change < 10 ? "0" : ""}{change}</data>
</price-tag>
