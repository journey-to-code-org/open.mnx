<!--
  The planner: owns the data (provided as context to everything inside), the route
  (`#/` or `#/events/<id>`) and the dialog that creates and edits events.
-->
<script>
  import { provide, onMount } from '@mnx/runtime'
  import { Planner, createPlanner, blankEvent } from '../store.js'
  import './month-calendar.mnx'
  import './upcoming-list.mnx'
  import './event-page.mnx'
  import './event-dialog.mnx'

  const planner = createPlanner(globalThis.localStorage ?? null)
  provide(Planner, planner)

  const read = () => {
    const match = /^#\/events\/([\w-]+)/.exec(globalThis.location?.hash ?? "")
    return match ? match[1] : ""
  }
  let eventId = read()
  onMount(() => {
    const follow = () => (eventId = read())
    addEventListener('hashchange', follow)
    return () => removeEventListener('hashchange', follow)
  })

  let editing = null
  const create = (day) => (editing = blankEvent(day))
  const edit = () => (editing = planner.find(eventId))

  function save(event) {
    const id = planner.save(event.detail)
    editing = null
    location.hash = `#/events/${id}`
  }
  function remove() {
    planner.remove(eventId)
    location.hash = "#/"
  }
</script>
<style>
  :host { display: block; max-width: 72rem; margin: 0 auto; padding: 0 1.25rem 4rem; }
  header { display: flex; align-items: center; gap: 1rem; padding: 1.25rem 0; }
  header a { font-weight: 800; font-size: 1.125rem; color: inherit; text-decoration: none; letter-spacing: -0.01em; }
  header a span { color: var(--accent); }
  header button { margin-left: auto; }
  .home { display: grid; grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr); gap: 1.5rem; align-items: start; }
  @media (max-width: 52rem) { .home { grid-template-columns: 1fr; } }
</style>
<planner-app>
  <header>
    <a href="#/">mnx <span>planner</span></a>
    <button type="button" class="primary new-event" onclick={() => create()}>New event</button>
  </header>
  <mnx-if test={eventId}>
    <event-page event-id={eventId} onedit={edit} onremove={remove}></event-page>
    <mnx-else>
      <div class="home">
        <month-calendar ondaypick={(event) => create(event.detail)}></month-calendar>
        <upcoming-list></upcoming-list>
      </div>
    </mnx-else>
  </mnx-if>
  <event-dialog event={editing} onsave={save} onclose={() => (editing = null)}></event-dialog>
</planner-app>
