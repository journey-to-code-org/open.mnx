<!--
  A month grid. Each day lists its events (links to their pages); choosing a day's empty space
  asks for a new event on it.
  @fires daypick - A day was chosen; `detail` is the day ("YYYY-MM-DD").
-->
<script>
  import { emit, computed } from '@zubra/runtime'
  import { usePlanner } from '../store.js'
  import { today, monthOf, addMonths, weeksOf, formatMonth, formatDay } from '../dates.js'

  const { events } = usePlanner()
  let month = monthOf(today())
  const weeks = weeksOf(month)
  // The store's events are a signal from context, not a prop or a `let`, so this is an
  // explicit computed.
  const byDay = computed(() => {
    const map = {}
    for (const event of events.get()) (map[event.day] ??= []).push(event)
    for (const list of Object.values(map)) list.sort((a, b) => a.start.localeCompare(b.start))
    return map
  })
  const now = today()
</script>
<style>
  :host { display: block; padding: 1rem; border-radius: 1rem; background: var(--surface); box-shadow: var(--shadow); }
  .bar { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; }
  h2 { margin: 0 auto 0 0.25rem; font-size: 1.25rem; }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  th { padding: 0.25rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  td { height: 5.5rem; padding: 0; border: 1px solid var(--line); vertical-align: top; }
  .day { display: flex; flex-direction: column; gap: 2px; width: 100%; height: 100%; padding: 0.25rem; border: 0; border-radius: 0; background: none; text-align: left; cursor: pointer; }
  .day:hover { background: var(--hover); }
  .num { font-size: 0.8125rem; font-weight: 600; width: 1.6rem; height: 1.6rem; display: grid; place-items: center; border-radius: 50%; }
  .other .num { color: var(--muted); opacity: 0.6; }
  .today .num { background: var(--accent); color: white; }
  a { display: block; overflow: hidden; padding: 1px 0.35rem; border-radius: 0.3rem; font-size: 0.75rem; line-height: 1.4; white-space: nowrap; text-overflow: ellipsis; text-decoration: none; color: var(--chip-ink); background: var(--chip); border-left: 3px solid var(--cat-other); }
  a[data-category=party] { border-color: var(--cat-party); }
  a[data-category=work] { border-color: var(--cat-work); }
  a[data-category=family] { border-color: var(--cat-family); }
  a[data-category=travel] { border-color: var(--cat-travel); }
  /* On a phone a day is too narrow for titles: each event is a colored bar (the text stays for
     screen readers). */
  @media (max-width: 40rem) {
    td { height: 3.5rem; }
    a { height: 0.35rem; padding: 0; font-size: 0; border-left-width: 0; background: var(--cat-other); }
    a[data-category=party] { background: var(--cat-party); }
    a[data-category=work] { background: var(--cat-work); }
    a[data-category=family] { background: var(--cat-family); }
    a[data-category=travel] { background: var(--cat-travel); }
  }
</style>
<month-calendar>
  <div class="bar">
    <h2 aria-live="polite">{formatMonth(month)}</h2>
    <button type="button" class="prev" aria-label="Previous month" onclick={() => (month = addMonths(month, -1))}>‹</button>
    <button type="button" class="today-button" onclick={() => (month = monthOf(today()))}>Today</button>
    <button type="button" class="next" aria-label="Next month" onclick={() => (month = addMonths(month, 1))}>›</button>
  </div>
  <table>
    <thead><tr><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th><th>Sun</th></tr></thead>
    <tbody>
      <zb-each items={weeks} as="week" key={week[0]}>
        <tr>
          <zb-each items={week} as="day" key={day}>
            <td class:other={monthOf(day) !== month} class:today={day === now} data-day={day}>
              <div class="day" role="button" tabindex="0" aria-label={`Add an event on ${formatDay(day)}`} onclick={(e) => e.target.closest('a') || emit('daypick', day)} onkeydown={(e) => e.key === "Enter" && e.target === e.currentTarget && emit('daypick', day)}>
                <span class="num">{Number(day.slice(8))}</span>
                <zb-each items={byDay[day] ?? []} as="event" key={event.id}>
                  <a href={`#/events/${event.id}`} data-category={event.category} title={`${event.start} ${event.title}`}>{event.start} {event.title}</a>
                </zb-each>
              </div>
            </td>
          </zb-each>
        </tr>
      </zb-each>
    </tbody>
  </table>
</month-calendar>
