<!--
  A card with two faces that flips in 3D. Click, Space or Enter flips it. Shadow DOM: the faces
  are slotted, and the page's CSS styles them, not the card's.
  @slot front - The question side.
  @slot back - The answer side.
  @fires flippedchange - It was flipped; `detail` is whether the back is showing.
-->
<script>
  function flip() {
    flipped = !flipped
  }
</script>
<style>
  :host { display: block; perspective: 1400px; }
  .card { position: relative; display: grid; min-height: 15rem; transform-style: preserve-3d; transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); cursor: pointer; border-radius: 1.25rem; outline: none; }
  .card:focus-visible { box-shadow: 0 0 0 3px var(--accent, #36c); }
  .flipped { transform: rotateY(180deg); }
  .face { grid-area: 1 / 1; display: grid; place-items: center; padding: 2rem; border-radius: 1.25rem; backface-visibility: hidden; background: var(--card-front, #fff); box-shadow: 0 2px 4px #0001, 0 16px 40px #00000014; text-align: center; }
  .back { transform: rotateY(180deg); background: var(--card-back, #fdf8ee); }
  .hint { position: absolute; bottom: 0.75rem; left: 0; right: 0; text-align: center; font-size: 0.75rem; color: var(--muted, #888); backface-visibility: hidden; }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } }
</style>
<flip-card shadow flipped:model={false} hint="Click or press Space to flip">
  <div
    class="card"
    class:flipped
    role="button"
    tabindex="0"
    aria-pressed={flipped ? "true" : "false"}
    aria-label={flipped ? "Answer (flip back)" : "Question (flip to see the answer)"}
    onclick={flip}
    onkeydown.space.enter.prevent={flip}
  >
    <div class="face front" aria-hidden={flipped ? "true" : "false"}><zb-slot name="front"></zb-slot></div>
    <div class="face back" aria-hidden={flipped ? "false" : "true"}><zb-slot name="back"></zb-slot></div>
    <span class="hint">{hint}</span>
  </div>
</flip-card>
