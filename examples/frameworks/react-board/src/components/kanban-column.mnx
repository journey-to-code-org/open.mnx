<!--
  A board column: a heading with a count and an optional work-in-progress limit, its cards (the
  default slot) and a drop zone for cards dragged from anywhere on the board.
  @slot - The cards, each a `task-card`.
  @slot actions - Buttons under the cards.
  @fires carddrop - A card was dropped here; `detail` is `{ id, index }` (where among the cards).
-->
<script>
  import { emit, hasSlot } from '@mnx/runtime'

  const hasActions = hasSlot('actions')
  let list = null
  let over = false
  const full = limit > 0 && count > limit

  /** Where among this column's cards a drop at `y` lands. */
  function indexAt(y) {
    const cards = [...list.querySelectorAll('task-card')]
    const after = cards.findIndex((card) => {
      const box = card.getBoundingClientRect()
      return y < box.top + box.height / 2
    })
    return after === -1 ? cards.length : after
  }
  function dragover(event) {
    if (!event.dataTransfer.types.includes('application/x-card')) return
    event.preventDefault()
    event.dataTransfer.dropEffect = 'move'
    over = true
  }
  function drop(event) {
    const id = event.dataTransfer.getData('application/x-card')
    over = false
    if (!id) return
    event.preventDefault()
    emit('carddrop', { id, index: indexAt(event.clientY) })
  }
</script>
<style>
  :host { display: flex; flex-direction: column; min-width: 13rem; max-width: 20rem; flex: 1; }
  section { display: flex; flex-direction: column; flex: 1; padding: 0.6rem; border-radius: 0.9rem; background: var(--column); transition: background 0.15s, box-shadow 0.15s; }
  section.over { background: var(--column-over); box-shadow: inset 0 0 0 2px var(--accent); }
  header { display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.35rem 0.6rem; }
  h2 { margin: 0; font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .count { padding: 0 0.45rem; border-radius: 999px; background: var(--surface); font-size: 0.75rem; font-weight: 700; color: var(--muted); }
  .full .count { background: var(--danger); color: white; }
  .limit { margin-left: auto; font-size: 0.75rem; color: var(--muted); }
  .full .limit { color: var(--danger); font-weight: 700; }
  .cards { display: flex; flex-direction: column; gap: 0.5rem; flex: 1; min-height: 4rem; }
  footer { display: flex; flex-direction: column; }
  .empty { display: grid; place-items: center; flex: 1; min-height: 4rem; border: 2px dashed var(--line); border-radius: 0.7rem; color: var(--muted); font-size: 0.8125rem; }
</style>
<kanban-column heading="" count={0} limit={0}>
  <section class:over class:full aria-label={heading} ondragover={dragover} ondragleave={(event) => event.currentTarget.contains(event.relatedTarget) || (over = false)} ondrop={drop}>
    <header>
      <h2>{heading}</h2>
      <span class="count">{count}</span>
      <mnx-if test={limit > 0}><span class="limit">{full ? `over the limit of ${limit}` : `limit ${limit}`}</span></mnx-if>
    </header>
    <div class="cards" ref={list}>
      <mnx-slot><div class="empty">Drop cards here</div></mnx-slot>
    </div>
    <mnx-if test={hasActions}><footer><mnx-slot name="actions"></mnx-slot></footer></mnx-if>
  </section>
</kanban-column>
