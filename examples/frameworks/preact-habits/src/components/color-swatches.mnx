<!--
  Pick a colour from `colors`. A form control (a radio group): arrow keys move the choice.
  @fires valuechange - The colour changed; `detail` is the colour.
-->
<script>
  import { emit, formValue, host } from '@mnx/runtime'

  const element = host()
  formValue(() => value)

  function pick(color) {
    if (color === value) return
    value = color
    emit('valuechange', color)
  }
  function key(event, index) {
    const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key]
    if (!step) return
    event.preventDefault()
    const next = colors[(index + step + colors.length) % colors.length]
    pick(next)
    queueMicrotask(() => element.querySelector(`[data-color="${next}"]`)?.focus())
  }
</script>
<style>
  :host { display: block; }
  div { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  button { width: 1.75rem; height: 1.75rem; padding: 0; border: 2px solid transparent; border-radius: 50%; cursor: pointer; box-shadow: inset 0 0 0 2px var(--surface); }
  button[aria-checked=true] { border-color: var(--ink); }
  .c0 { background: #16a34a; } .c1 { background: #2563eb; } .c2 { background: #db2777; } .c3 { background: #ea580c; } .c4 { background: #7c3aed; } .c5 { background: #0891b2; }
</style>
<color-swatches form-associated value="#16a34a" colors={["#16a34a", "#2563eb", "#db2777", "#ea580c", "#7c3aed", "#0891b2"]} label="Colour">
  <div role="radiogroup" aria-label={label}>
    <mnx-each items={colors} as="color" index="index" key={color}>
      <button type="button" role="radio" class={`c${index}`} data-color={color} aria-label={color} aria-checked={color === value ? "true" : "false"} tabindex={color === value ? "0" : "-1"} onclick={() => pick(color)} onkeydown={(event) => key(event, index)}></button>
    </mnx-each>
  </div>
</color-swatches>
