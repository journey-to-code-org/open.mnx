<!--
  Pick a colour from `colors`. A form control (a radio group): arrow keys move the choice.
  @fires valuechange - The colour changed; `detail` is the colour.
-->
<script>
  let group = null

  function pick(color) {
    if (color === value) return
    value = color
  }
  function move(index, step) {
    const next = colors[(index + step + colors.length) % colors.length]
    pick(next)
    queueMicrotask(() => group.querySelector(`[data-color="${next}"]`)?.focus())
  }
</script>
<style>
  :host { display: block; }
  div { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  button { width: 1.75rem; height: 1.75rem; padding: 0; border: 2px solid transparent; border-radius: 50%; cursor: pointer; box-shadow: inset 0 0 0 2px var(--surface); }
  button[aria-checked=true] { border-color: var(--ink); }
</style>
<color-swatches form-associated value:model="#16a34a" colors={["#16a34a", "#2563eb", "#db2777", "#ea580c", "#7c3aed", "#0891b2"]} label="Colour">
  <div role="radiogroup" aria-label={label} ref={group}>
    <mnx-each items={colors} as="color" index="index" key={color}>
      <button type="button" role="radio" style:background={color} data-color={color} aria-label={color} aria-checked={color === value ? "true" : "false"} tabindex={color === value ? "0" : "-1"} onclick={() => pick(color)} onkeydown.right.down.prevent={() => move(index, 1)} onkeydown.left.up.prevent={() => move(index, -1)}></button>
    </mnx-each>
  </div>
</color-swatches>
