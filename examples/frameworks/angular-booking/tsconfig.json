{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "types": ["@zubra/unplugin/client"],
    "allowJs": true,
    "useDefineForClassFields": false
  },
  "files": ["src/main.ts"],
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
