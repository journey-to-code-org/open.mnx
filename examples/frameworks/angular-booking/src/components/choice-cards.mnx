<!--
  Pick one of several cards: a radio group. A form control; arrow keys move the choice.
  Each item is `{ id, title, detail, price, note }` (`note` and `price` optional).
  @fires valuechange - The choice changed; `detail` is the chosen id.
-->
<script>
  import { emit, formValue, validity, host } from '@mnx/runtime'

  const element = host()
  formValue(() => value || null)
  validity(() => (required && !value ? "Choose one" : ""))

  function choose(item) {
    if (item.disabled || item.id === value) return
    value = item.id
    emit('valuechange', item.id)
  }
  function key(event, index) {
    const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[event.key]
    if (!step) return
    event.preventDefault()
    const enabled = items.filter((item) => !item.disabled)
    const at = enabled.findIndex((item) => item.id === items[index].id)
    const next = enabled[(at + step + enabled.length) % enabled.length]
    choose(next)
    queueMicrotask(() => element.querySelector(`[data-id="${next.id}"]`)?.focus())
  }
</script>
<style>
  :host { display: block; }
  [role=radiogroup] { display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: 0.75rem; }
  button { display: grid; gap: 0.25rem; text-align: left; padding: 0.9rem 1rem; border: 2px solid var(--line, #dde); border-radius: 0.9rem; background: var(--surface, #fff); color: inherit; font: inherit; cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s; }
  button:hover:not(:disabled) { border-color: color-mix(in srgb, var(--accent, #36c) 50%, transparent); }
  button[aria-checked=true] { border-color: var(--accent, #36c); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent, #36c) 20%, transparent); }
  button:disabled { opacity: 0.45; cursor: not-allowed; }
  strong { font-size: 1rem; }
  .detail { font-size: 0.8125rem; color: var(--muted, #667); }
  .row { display: flex; justify-content: space-between; align-items: baseline; margin-top: 0.35rem; }
  .price { font-weight: 700; }
  .note { font-size: 0.75rem; font-weight: 600; color: var(--accent, #36c); }
</style>
<choice-cards form-associated value="" items={[]} required={false} label="">
  <div role="radiogroup" aria-label={label}>
  <mnx-each items={items} as="item" index="index" key={item.id}>
    <button type="button" role="radio" data-id={item.id} aria-checked={item.id === value ? "true" : "false"} tabindex={item.id === value || (!value && index === 0) ? "0" : "-1"} disabled={item.disabled ?? false} onclick={() => choose(item)} onkeydown={(event) => key(event, index)}>
      <strong>{item.title}</strong>
      <span class="detail">{item.detail}</span>
      <span class="row"><span class="note">{item.note ?? ""}</span><span class="price">{item.price ?? ""}</span></span>
    </button>
  </mnx-each>
  </div>
</choice-cards>
