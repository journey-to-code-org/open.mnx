<!--
  Writing a message: Enter sends, Shift+Enter adds a line, the box grows with the text, an
  emoji menu inserts at the caret, and a message being replied to shows above.
  @fires send - Send was chosen; `detail` is the trimmed text.
  @fires typing - The user typed (at most every two seconds).
  @fires replycancel - The reply was cancelled.
-->
<script>
  import { emit } from '@zubra/runtime'

  const EMOJI = ["😀", "😂", "😍", "🤔", "👍", "🙏", "🎉", "🔥", "🚀", "✅", "👀", "☕"]
  let box = null
  let text = ""
  let picking = false
  let lastTyping = 0
  const empty = text.trim() === ""

  function grow() {
    box.style.height = "auto"
    box.style.height = `${Math.min(box.scrollHeight, 160)}px`
  }
  function input(event) {
    text = event.target.value
    grow()
    if (Date.now() - lastTyping > 2000) {
      lastTyping = Date.now()
      emit('typing')
    }
  }
  function send() {
    if (empty || disabled) return
    emit('send', text.trim())
    text = ""
    lastTyping = 0
    queueMicrotask(grow)
  }
  function enter(event) {
    // (While an input method is composing, Enter belongs to it.)
    if (event.isComposing) return
    event.preventDefault()
    send()
  }
  function insert(emoji) {
    const at = box.selectionStart ?? text.length
    text = text.slice(0, at) + emoji + text.slice(box.selectionEnd ?? at)
    picking = false
    queueMicrotask(() => {
      box.focus()
      box.setSelectionRange(at + emoji.length, at + emoji.length)
    })
  }
</script>
<style>
  :host { display: block; }
  .reply { display: flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.75rem; border: 1px solid var(--line); border-bottom: 0; border-radius: 0.75rem 0.75rem 0 0; background: var(--hover); font-size: 0.8125rem; color: var(--muted); }
  .reply b { color: var(--ink); }
  .reply span { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .reply button { border: 0; background: none; color: inherit; cursor: pointer; font: inherit; }
  .box { position: relative; display: flex; align-items: flex-end; gap: 0.25rem; padding: 0.4rem; border: 1px solid var(--line); border-radius: 0.75rem; background: var(--surface); }
  .reply + .box { border-radius: 0 0 0.75rem 0.75rem; }
  .box:focus-within { border-color: var(--link); }
  textarea { flex: 1; min-height: 2.25rem; max-height: 10rem; padding: 0.45rem 0.5rem; border: 0; outline: 0; resize: none; background: none; color: inherit; font: inherit; line-height: 1.4; }
  button.icon, button.send { flex: none; width: 2.25rem; height: 2.25rem; border: 0; border-radius: 0.55rem; background: none; color: var(--muted); font-size: 1.15rem; cursor: pointer; }
  button.send { background: var(--link); color: white; font-size: 1rem; }
  button.send:disabled { background: var(--line); color: var(--muted); cursor: default; }
  .picker { position: absolute; bottom: calc(100% + 0.4rem); right: 0; display: grid; grid-template-columns: repeat(6, 2rem); gap: 0.15rem; padding: 0.4rem; border: 1px solid var(--line); border-radius: 0.75rem; background: var(--surface); box-shadow: 0 8px 24px #0003; }
  .picker button { border: 0; background: none; border-radius: 0.4rem; font-size: 1.2rem; cursor: pointer; }
  .picker button:hover { background: var(--hover); }
  .hint { margin: 0.3rem 0.25rem 0; font-size: 0.7rem; color: var(--muted); }
</style>
<message-composer placeholder="Message" disabled={false} replyto={null}>
  <div zb-if={replyto} class="reply"><span>Replying to <b>{replyto?.author}</b>: {replyto?.text}</span><button type="button" class="cancel-reply" aria-label="Cancel reply" onclick={() => emit('replycancel')}>×</button></div>
  <div class="box">
    <textarea rows="1" aria-label={placeholder} placeholder={placeholder} disabled={disabled} value={text} ref={box} oninput={input} onkeydown.enter={enter} onkeydown.escape={() => replyto && emit('replycancel')}></textarea>
    <button type="button" class="icon emoji" aria-label="Insert emoji" aria-expanded={picking ? "true" : "false"} onclick={() => (picking = !picking)}>☺</button>
    <button type="button" class="send" aria-label="Send" disabled={empty || disabled} onclick={send}>➤</button>
    <div zb-if={picking} class="picker" role="menu"><zb-each items={EMOJI} as="emoji" key={emoji}><button type="button" role="menuitem" onclick={() => insert(emoji)}>{emoji}</button></zb-each></div>
  </div>
  <p class="hint">Enter to send · Shift+Enter for a new line</p>
</message-composer>
