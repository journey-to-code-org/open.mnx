<!--
  Who's typing, with three bouncing dots. Empty when nobody is.
-->
<script>
  const text = names.length === 0 ? "" : names.length === 1 ? `${names[0]} is typing` : names.length === 2 ? `${names[0]} and ${names[1]} are typing` : "Several people are typing"
</script>
<style>
  :host { display: block; min-height: 1.4rem; font-size: 0.8125rem; color: var(--muted); }
  .dots { display: inline-flex; gap: 0.18rem; margin-left: 0.3rem; vertical-align: middle; }
  .dots i { width: 0.3rem; height: 0.3rem; border-radius: 50%; background: currentColor; animation: bounce 1s infinite; }
  .dots i:nth-child(2) { animation-delay: 0.15s; }
  .dots i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes bounce { 0%, 60%, 100% { transform: none; opacity: 0.5; } 30% { transform: translateY(-0.25rem); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .dots i { animation: none; } }
</style>
<typing-dots names={[]}>
  <zb-if test={text}><span aria-live="polite"><span class="who">{text}</span><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span></span></zb-if>
</typing-dots>
