<!--
  A drink or pastry on the menu: pick a size, add it to the order. Light DOM, styled only with
  Tailwind utilities, including a `data-active:` variant on the sizes and an arbitrary value.
  `item` is { id, name, description, category, tag?, prices: { size: price } }; `count` is how
  many are in the order.
  @fires add - Add one to the order; `detail` is { id, size }.
-->
<script>
  import { emit } from '@zubra/runtime'

  const sizes = Object.keys(item.prices ?? {})
  let size = sizes[Math.min(1, sizes.length - 1)]
  const price = item.prices?.[size] ?? 0
  const money = (amount) => `$${amount.toFixed(2)}`
</script>
<menu-card item={{}} count={0}>
  <article class="group flex h-full flex-col rounded-2xl border border-stone-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-stone-800 dark:bg-stone-900">
    <div class="mb-1 flex items-start justify-between gap-2">
      <h3 class="font-semibold">{item.name}</h3>
      <span zb-if={item.tag} class="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800 dark:bg-amber-900/50 dark:text-amber-200">{item.tag}</span>
    </div>
    <p class="mb-4 text-sm text-stone-500 dark:text-stone-400">{item.description}</p>
    <div class="mt-auto flex items-center justify-between gap-2">
      <div zb-if={sizes.length > 1} role="group" aria-label={`Size of ${item.name}`} class="flex gap-1">
        <zb-each items={sizes} as="option" key={option}>
          <button type="button" aria-pressed={option === size ? "true" : "false"} data-active={option === size ? "" : null} onclick={() => (size = option)}
            class="size-8 rounded-lg border border-stone-200 text-xs font-semibold uppercase text-stone-500 data-active:border-roast data-active:bg-roast data-active:text-white dark:border-stone-700 dark:text-stone-400">
            {option}
          </button>
        </zb-each>
      </div>
      <span zb-else class="text-xs uppercase tracking-wide text-stone-400">One size</span>
      <button type="button" onclick={() => emit("add", { id: item.id, size })}
        class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-xl bg-amber-600 px-3 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-amber-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 active:scale-[0.97]">
        Add · {money(price)}
        <span zb-if={count > 0} class="grid min-w-5 place-items-center rounded-full bg-white/25 px-1 text-xs" aria-label={`${count} in your order`}>{count}</span>
      </button>
    </div>
  </article>
</menu-card>
