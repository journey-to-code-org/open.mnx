<!--
  The order so far. A shadow-DOM component: page CSS doesn't reach in, so the page passes
  Tailwind's compiled CSS to `adoptStyles()` (src/main.js), and the same utilities work here.
  `lines` is [{ key, name, size, price, count }].
  @fires remove - Take one away; `detail` is the line's key.
  @fires checkout - Place the order.
-->
<script>
  import { emit } from '@zubra/runtime'

  const money = (amount) => `$${amount.toFixed(2)}`
  const subtotal = lines.reduce((sum, line) => sum + line.price * line.count, 0)
  const tax = Math.round(subtotal * 0.07 * 100) / 100
  const items = lines.reduce((sum, line) => sum + line.count, 0)
</script>
<order-summary shadow lines={[]} placed={false}>
  <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm dark:border-stone-800 dark:bg-stone-900" aria-labelledby="order-heading">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 id="order-heading" class="text-lg font-bold tracking-tight">Your order</h2>
      <span class="text-sm text-stone-500 dark:text-stone-400">{items} {items === 1 ? "item" : "items"}</span>
    </div>
    <p zb-if={placed} class="rounded-xl bg-emerald-50 p-4 text-sm font-medium text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200" role="status">Order placed. We'll call your name.</p>
    <p zb-else-if={lines.length === 0} class="rounded-xl border border-dashed border-stone-300 p-6 text-center text-sm text-stone-500 dark:border-stone-700">Nothing yet. Add something from the menu.</p>
    <ul zb-else class="mb-4 divide-y divide-stone-100 dark:divide-stone-800">
      <zb-each items={lines} as="line" key={line.key}>
        <li class="flex items-center gap-3 py-2.5">
          <span class="grid size-7 shrink-0 place-items-center rounded-lg bg-stone-100 text-xs font-bold dark:bg-stone-800">{line.count}×</span>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-medium">{line.name}</span>
            <span class="text-xs uppercase text-stone-500">{line.size}</span>
          </span>
          <span class="text-sm tabular-nums">{money(line.price * line.count)}</span>
          <button type="button" aria-label={`Remove one ${line.name}`} onclick={() => emit("remove", line.key)}
            class="grid size-7 place-items-center rounded-full text-stone-400 hover:bg-stone-100 hover:text-stone-700 dark:hover:bg-stone-800">−</button>
        </li>
      </zb-each>
    </ul>
    <dl zb-if={lines.length > 0 && !placed} class="mb-4 space-y-1 text-sm">
      <div class="flex justify-between text-stone-500"><dt>Subtotal</dt><dd class="tabular-nums">{money(subtotal)}</dd></div>
      <div class="flex justify-between text-stone-500"><dt>Tax</dt><dd class="tabular-nums">{money(tax)}</dd></div>
      <div class="flex justify-between text-base font-semibold"><dt>Total</dt><dd class="tabular-nums" data-total>{money(subtotal + tax)}</dd></div>
    </dl>
    <button zb-if={!placed} type="button" disabled={lines.length === 0} onclick={() => emit("checkout")}
      class="w-full rounded-xl bg-stone-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-stone-700 disabled:cursor-not-allowed disabled:opacity-40 dark:bg-white dark:text-stone-900 dark:hover:bg-stone-200">
      Place order
    </button>
  </section>
</order-summary>
