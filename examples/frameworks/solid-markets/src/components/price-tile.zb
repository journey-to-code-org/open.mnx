<!--
  A symbol on the watchlist: price, change since the open, a spark line, and a flash when the
  price moves.
  @fires tileselect - The tile was chosen.
  @fires tileremove - The remove button was pressed.
-->
<script>
  import { emit, watch } from '@zubra/runtime'
  import './spark-line.zb'

  let flash = ""
  let timer = 0
  watch(() => price, (next, previous) => {
    flash = next > previous ? "rise" : next < previous ? "fall" : ""
    clearTimeout(timer)
    timer = setTimeout(() => (flash = ""), 600)
  })
  const change = open ? (price - open) / open : 0
  const sign = change > 0 ? "+" : change < 0 ? "−" : ""
</script>
<style>
  :host { display: block; }
  article { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 0.15rem 0.75rem; padding: 0.8rem 0.9rem; border-radius: 0.9rem; border: 1px solid var(--line); background: var(--surface); cursor: pointer; transition: background 0.6s, border-color 0.15s; }
  article:hover { border-color: var(--muted); }
  article.selected { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  article.rise { background: var(--up-wash); transition: none; }
  article.fall { background: var(--down-wash); transition: none; }
  .symbol { font-weight: 800; letter-spacing: 0.02em; }
  .name { grid-column: 1; font-size: 0.75rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .price { grid-row: 1; grid-column: 2; text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }
  .change { grid-row: 2; grid-column: 2; text-align: right; font-size: 0.8125rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .change.up { color: var(--up); } .change.down { color: var(--down); }
  spark-line { grid-column: 1 / -1; margin-top: 0.4rem; }
  .remove { position: absolute; top: 0.25rem; right: 0.3rem; display: none; border: 0; background: var(--surface); color: var(--muted); border-radius: 50%; width: 1.4rem; height: 1.4rem; cursor: pointer; }
  article:hover .remove, .remove:focus-visible { display: block; }
</style>
<price-tile symbol="" name="" price={0} open={0} points={[]} selected={false}>
  <article class={flash} class:selected tabindex="0" aria-label={`${symbol} ${price.toFixed(2)}`} aria-pressed={selected ? "true" : "false"} onclick={() => emit('tileselect')} onkeydown.enter.space.prevent={() => emit('tileselect')}>
    <span class="symbol">{symbol}</span>
    <span class="name">{name}</span>
    <span class="price">{price.toFixed(2)}</span>
    <span class="change" class:up={change > 0} class:down={change < 0}>{sign}{Math.abs(change * 100).toFixed(2)}%</span>
    <spark-line points={points}></spark-line>
    <button type="button" class="remove" aria-label={`Remove ${symbol}`} onclick={(event) => (event.stopPropagation(), emit('tileremove'))}>×</button>
  </article>
</price-tile>
