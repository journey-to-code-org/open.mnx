{
  "name": "@zubra/server",
  "version": "5.3.0",
  "description": "Zubra on the server: render components into any template engine's pages, serve their browser modules, and give frameworks' HTML its components' shadow roots.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./express": {
      "types": "./src/adapters.d.ts",
      "default": "./src/express.js"
    },
    "./fastify": {
      "types": "./src/adapters.d.ts",
      "default": "./src/fastify.js"
    },
    "./hono": {
      "types": "./src/adapters.d.ts",
      "default": "./src/hono.js"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "peerDependencies": {
    "@zubra/compiler": "^5.3.0",
    "@zubra/runtime": "^5.3.0"
  },
  "devDependencies": {
    "@minify-html/node": "0.18.1",
    "@swc/html": "1.16.22",
    "@zubra/compiler": "file:../compiler",
    "@zubra/runtime": "file:../runtime",
    "dompurify": "3.4.17",
    "express": "5.3.0",
    "fastify": "5.12.8",
    "hono": "4.13.17",
    "html-minifier-terser": "7.2.0",
    "htmlnano": "3.6.1",
    "jsdom": "31.0.0",
    "playwright": "1.63.0",
    "sanitize-html": "2.18.1"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/journey-to-code-org/zubra.git",
    "directory": "server"
  }
}
